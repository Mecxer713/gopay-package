{
  "name": "@mecxer713/gopay",
  "version": "0.2.0",
  "description": "Official JavaScript and TypeScript client for GoPAY Mobile Money payment and payout gateway.",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('dist-test',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.cjs.json && tsc -p tsconfig.build.esm.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test dist-test/test/client.test.js",
    "test:package": "npm run build && node test/package-smoke.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mecxer713/gopay-package.git",
    "directory": "javascript-sdk"
  },
  "keywords": [
    "gopay",
    "payment",
    "payout",
    "mobile-money",
    "mpesa",
    "airtelmoney",
    "orange-money",
    "drc",
    "fintech",
    "typescript"
  ],
  "author": "Mecxer713 <Mecxer@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Mecxer713/gopay-package/issues"
  },
  "homepage": "https://gopay.gooomart.com",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
